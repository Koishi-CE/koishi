// client 侧大一统类型检查入口：浏览器端工程（extends tsconfig.client 的
// 17 个 client tsconfig.json）的 include 并集，与 tsconfig.json（node 侧）
// 一同构成全量类型检查的两条 bunx tsc 指令。基座 tsconfig.client.json
// 保持纯净（仅被 extends，不带 include）。
//
// paths 为各工程 paths 覆盖的合并（extends 的 paths 会被整体替换，故须
// 重写基座已有映射）；exclude 收录各工程 exclude 的并集——
// schemastery-vue-runtime.ts 引入的第三方源码不满足超严格配置，原工程
// 即显式排除，只允许进入打包管线（见该文件头注释）。
{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.client",
	"include": [
		"packages/web/client/app",
		"packages/web/client/client",
		"packages/web/components/client",
		"plugins/webui/admin/client",
		"plugins/webui/analytics/client",
		"plugins/webui/auth/client",
		"plugins/webui/commands/client",
		"plugins/webui/config/client",
		"plugins/webui/dataview/client",
		"plugins/webui/explorer/client",
		"plugins/webui/insight/client",
		"plugins/webui/locales/client",
		"plugins/webui/logger/client",
		"plugins/webui/market/client",
		"plugins/webui/notifier/client",
		"plugins/webui/sandbox/client",
		"plugins/webui/status/client",
		"plugins/webui/theme-vanilla/client",
		"plugins/webui/welcome/client"
	],
	"exclude": [
		"packages/web/components/client/schemastery-vue-runtime.ts",
		// web 侧测试文件运行时由 bun test 覆盖；client 工程 types: [] 保持
		// 浏览器纯净（不载 bun），故测试代码不进入本类型检查
		"packages/web/client/client/**/*.test.ts",
		"packages/web/components/client/**/*.test.ts",
		"plugins/webui/explorer/client/**/*.test.ts",
		"plugins/webui/market/client/**/*.test.ts"
	],
	"compilerOptions": {
		// 与 tsconfig.json（node 侧）各自独立一份 buildinfo，共用会互相判失效（见该文件头注释）。
		"incremental": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsc/web.tsbuildinfo",
		"paths": {
			"schemastery-vue/client": [
				"./packages/web/components/client/schemastery-vue-client.ts"
			],
			"@koishi-ce/plugin-config/client": [
				"./plugins/webui/config/client/index.ts"
			],
			"@koishi-ce/plugin-config": [
				"./plugins/webui/config/lib/index.d.ts"
			],
			"@koishi-ce/plugin-market": [
				"./plugins/webui/market/lib/index.d.ts"
			],
			"@koishi-ce/plugin-dataview": [
				"./plugins/webui/dataview/lib/index.d.ts"
			],
			"vue": ["./packages/web/client/node_modules/vue"],
			"@vueuse/core": [
				"./packages/web/client/node_modules/@vueuse/core"
			],
			"@koishi-ce/console": [
				"./packages/node/console/lib/index.d.ts"
			],
			"@koishi-ce/registry": [
				"./packages/node/registry/lib/index.d.ts"
			],
			"@koishi-ce/koishi": [
				"./packages/node/cli/lib/index.d.ts"
			],
			// 以下为 client 生态裸名与跨插件类型增强导入的显式映射：构建期由
			// collectWorkspaceAliases 解析，但 vue-tsc 闸门按 paths 走，缺口会
			// 以 TS2307 落基线（此前 27 条白名单即此因）
			"vue-i18n": [
				"./packages/web/client/node_modules/vue-i18n"
			],
			"vue-router": [
				"./packages/web/client/node_modules/vue-router"
			],
			"element-plus": [
				"./packages/web/client/node_modules/element-plus"
			],
			"@koishi-ce/plugin-admin/src": [
				"./plugins/webui/admin/lib/index.d.ts"
			],
			"@koishi-ce/plugin-analytics/src": [
				"./plugins/webui/analytics/lib/index.d.ts"
			],
			"@koishi-ce/plugin-commands/src": [
				"./plugins/webui/commands/lib/index.d.ts"
			],
			"@koishi-ce/plugin-notifier/src": [
				"./plugins/webui/notifier/lib/index.d.ts"
			]
		}
	}
}
