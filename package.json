{
	"name": "koishi",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"workspaces": [
		"packages/node/*",
		"packages/web/*",
		"plugins/common/*",
		"plugins/infra/*",
		"plugins/webui/*",
		"apps/*",
		"tooling/*"
	],
	"scripts": {
		"lint": "biome check .",
		"format": "biome format --write .",
