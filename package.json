{
    "name": "koishi",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "packageManager": "bun@1.4.2",
    "workspaces": [
        "packages/node/*",
        "packages/shim/*",
        "packages/web/*",
        "plugins/common/*",
        "plugins/infra/*",
        "plugins/webui/*",
        "apps/*"
    ],
    "scripts": {
        "check": "bun run lint && bun run lint:client && bun run typecheck && bun run check:locales && bun run check:docs-links && bun run check:vue-types && bun run check:assertions && bun run check:packages",
        "lint": "biome check .",
        "lint:client": "eslint \"packages/web/*/client/**/*.vue\" \"plugins/webui/*/client/**/*.vue\"",
        "check:locales": "bun tooling/checks/locales.ts",
        "check:docs-links": "bun tooling/checks/docs-links.ts",
        "check:vue-types": "bun tooling/checks/vue-types.ts",
        "check:assertions": "bun tooling/checks/assertions.ts",
        "check:packages": "bun tooling/checks/packages.ts",
        "sandbox": "bun tooling/sandbox/index.ts",
        "upstream:audit": "bun tooling/upstream-audit/index.ts",
        "fallow": "bunx fallow@3.25.0 dead-code",
        "fallow:full": "bunx fallow@3.25.0",
        "format": "biome format --write .",
        "typecheck": "bunx tsc -p tsconfig.json && bunx tsc -p tsconfig.web.json",
        "typecheck:legacy": "tsc6 --noEmit -p tsconfig.json --tsBuildInfoFile ./node_modules/.cache/tsc/node-legacy.tsbuildinfo",
        "ts7": "node node_modules/@typescript/native/bin/tsc",
        "build": "tsdown",
        "test": "bun test --isolate",
        "changeset": "changeset",
        "release": "bun tooling/release/index.ts"
    },
    "devDependencies": {
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "@types/node": "^26.4.0",
        "@types/bun": "^1.4.0",
        "eslint": "^10.9.1",
        "eslint-plugin-vue": "^10.10.0",
        "@typescript-eslint/parser": "^8.68.0",
        "vue-eslint-parser": "^10.4.1",
        "@biomejs/biome": "^2.5.10",
        "tsdown": "^0.23.0",
        "@changesets/cli": "^3.0.1"
    },
    "dependencies": {
        "@koishi-ce/plugin-http": "workspace:*",
        "@koishi-ce/plugin-proxy-agent": "workspace:*",
        "@koishi-ce/plugin-server": "workspace:*"
    }
}