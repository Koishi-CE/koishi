{
    "name": "koishi",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "packageManager": "bun@1.4.2",
    "workspaces": {
        "packages": [
            "packages/node/*",
            "packages/shim/*",
            "packages/web/*",
            "plugins/common/*",
            "plugins/infra/*",
            "plugins/webui/*",
            "apps/*"
        ],
        "catalog": {
            "cordis": "^3.18.1",
            "minato": "^3.7.0",
            "@satorijs/element": "^3.2.0",
            "cosmokit": "^1.8.1",
            "picocolors": "^1.1.1",
            "semver": "^7.8.6",
            "file-type": "^22.3.0"
        },
        "catalogs": {
            "web": {
                "vue": "^3.5.45",
                "vue-router": "^5.4.0",
                "vue-i18n": "^11.4.18",
                "@vueuse/core": "^15.0.0",
                "element-plus": "^2.14.5"
            },
            "build": {
                "vite": "^8.3.6"
            },
            "test": {
                "jsdom": "^30.1.3",
                "@types/semver": "^7.5.8"
            }
        }
    },
    "scripts": {
        "check": "bun run check:lint && bun run check:types && bun run check:tooling && bun run check:template",
        "check:lint": "bun run lint && bun run lint:client",
        "check:tooling": "bun run check:locales && bun run check:docs-links && bun run check:assertions && bun run check:packages && bun run check:console-wiring && bun run check:pr-templates",
        "check:types": "bun run typecheck",
        "check:template": "bun run check:vue-types",
        "lint": "biome check .",
        "lint:client": "eslint \"packages/web/*/src/**/*.vue\" \"plugins/webui/*/client/**/*.vue\"",
        "check:locales": "bun tooling/checks/locales.ts",
        "check:docs-links": "bun tooling/checks/docs-links.ts",
        "check:vue-types": "bun tooling/checks/vue-types.ts",
        "check:assertions": "bun tooling/checks/assertions.ts",
        "check:packages": "bun tooling/checks/packages.ts",
        "check:console-wiring": "bun tooling/checks/console-wiring.ts",
        "check:pr-templates": "bun tooling/checks/pr-templates.ts",
        "sandbox": "bun tooling/sandbox/index.ts",
        "upstream:audit": "bun tooling/upstream-audit/index.ts",
        "fallow": "bunx fallow@3.25.0 dead-code",
        "fallow:full": "bunx fallow@3.25.0",
        "format": "biome format --write .",
        "typecheck": "bunx tsc -p tsconfig.json && bunx tsc -p tsconfig.web.json",
        "typecheck:legacy": "tsc6 --noEmit -p tsconfig.json --tsBuildInfoFile ./node_modules/.cache/tsc/node-legacy.tsbuildinfo",
        "ts7": "node node_modules/@typescript/native/bin/tsc",
        "build": "NODE_OPTIONS=--max-old-space-size=6144 tsdown",
        "build:console": "bun packages/web/builder/src/bin.ts build",
        "test": "bun test --isolate",
        "test:ci": "bun test --isolate --parallel=4 --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
        "changeset": "changeset",
        "release": "bun tooling/release/index.ts"
    },
    "devDependencies": {
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "@types/node": "^26.6.6",
        "@types/bun": "^1.4.4",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "@typescript-eslint/parser": "^8.72.1",
        "vue-eslint-parser": "^10.4.1",
        "@biomejs/biome": "^2.5.15",
        "tsdown": "^0.23.5",
        "turbo": "2.11.10",
        "@changesets/cli": "^3.0.1"
    },
    "dependencies": {
        "@koishi-ce/plugin-http": "workspace:*",
        "@koishi-ce/plugin-proxy-agent": "workspace:*",
        "@koishi-ce/plugin-server": "workspace:*"
    }
}