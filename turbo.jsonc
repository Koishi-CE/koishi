{
	"$schema": "https://turborepo.com/schema.json",
	// CI 缓存配置（根级任务）。
	//
	// 本仓 node 侧构建是「根 tsdown 单遍构建全部包」，check / test 也都是根级单命令，
	// 所以可缓存的粒度就是这些根任务，而不是「每包一个构建任务」——用 //# 前缀声明
	// 根包任务。turbo 仍按输入内容哈希做内容寻址缓存，配上远程缓存（TURBO_TOKEN /
	// TURBO_TEAM）即可让 merge_group 那一遍直接复用 pull_request 那一遍的产物：
	// 实测最近 5 个已合并 PR，合并提交与 PR head 的 tree 逐字相同（#35–#39）。
	//
	// inputs 不显式声明：默认按包内未被 .gitignore 忽略的文件哈希，而 lib/ dist/
	// coverage/ node_modules/ 均已在 .gitignore 中，不会污染哈希。outputs 必须声明，
	// 命中时 turbo 会把它们从缓存还原（否则后续步骤拿不到产物）。
	"tasks": {
		"//#build": {
			"outputs": [
				"packages/*/*/lib/**",
				"plugins/*/*/lib/**",
				"apps/*/lib/**"
			]
		},
		"//#build:console": {
			"outputs": ["plugins/webui/console/dist/**"]
		},
		"//#check": {
			"dependsOn": ["//#build", "//#build:console"]
		},
		"//#test:ci": {
			"dependsOn": ["//#check"],
			"outputs": ["coverage/**"]
		},
		"//#fallow": {}
	}
}
