{
	"$schema": "https://json.schemastore.org/tsconfig",
	"files": ["packages/web/client/global.d.ts"],
	"compilerOptions": {
		"target": "ES2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"lib": ["ES2025", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"noEmit": true,
		"strict": true,
		"strictBindCallApply": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"types": [],
		"paths": {
			"schemastery-vue/client": [
				"./packages/web/components/client/schemastery-vue-client.ts"
			],
			"@koishi-ce/plugin-config/client": [
				"./plugins/webui/config/client/index.ts"
			],
			"@koishi-ce/plugin-config": [
				"./plugins/webui/config/lib/index.d.ts"
			],
			"@koishi-ce/plugin-market": [
				"./plugins/webui/market/lib/index.d.ts"
			]
		}
	}
}
