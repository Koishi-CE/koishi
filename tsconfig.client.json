// client（浏览器端）类型检查基座：被 tsconfig.web.json（大一统检查入口）与各
// webui 插件 client/tsconfig.json extends。extends 语义（2026-09-25 --showConfig
// 实证）：include 由子配置声明并整体替换，本 files（global.d.ts：*.vue / *.yml
// 模块声明 + vue-i18n / vite / element-plus 类型引用）却照原样下发进每个 client
// 子工程——含 .vue 导入的工程没有它直接 TS2307，是必要的共享声明而非可裁剪的
// 兜底。skipLibCheck 保持 true
// 的理由与不开启的选项以 tsconfig.base.json 的注释为准（本侧实测 false 时爆
// 63 条第三方 d.ts 错误，@vueuse/core、@satorijs/core 等，本仓代码零条）。
{
	"$schema": "https://json.schemastore.org/tsconfig",
	"files": ["packages/web/client/global.d.ts"],
	"compilerOptions": {
		"target": "ES2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"lib": ["ES2025", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"noEmit": true,
		"strict": true,
		"strictBindCallApply": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		// 对不存在的副作用导入报 TS2882（TS7 project 模式探针实证生效，零误报）
		"noUncheckedSideEffectImports": true,
		// 报错展示 DX 项，不影响检查结果
		"noErrorTruncation": true,
		// 浏览器纯净：不载 node/bun 类型；web 侧 *.test.ts 因此不进本程序
		// （由 bun test 运行时覆盖，见 tsconfig.web.json 的 exclude 说明）
		"types": [],
		"paths": {
			"schemastery-vue/client": [
				"./packages/web/components/src/schemastery-vue-client.ts"
			],
			"@koishi-ce/plugin-config/client": [
				"./plugins/webui/config/client/index.ts"
			],
			"@koishi-ce/plugin-config": [
				"./plugins/webui/config/lib/index.d.ts"
			],
			"@koishi-ce/plugin-market": [
				"./plugins/webui/market/lib/index.d.ts"
			]
		}
	}
}
