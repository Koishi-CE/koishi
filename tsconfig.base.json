{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"strictBindCallApply": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@satorijs/element",
		"types": ["yml-register/types"],
		"noEmit": true
	}
}
