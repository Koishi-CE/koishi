{
	"$schema": "https://json.schemastore.org/tsconfig",
	"files": ["typings/yml.d.ts"],
	"compilerOptions": {
		"target": "ES2025",
		"module": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"lib": ["ES2025"],
		"types": ["node", "bun-types"],
		"paths": {
			"@koishi-ce/koishi": ["./packages/node/cli/src"],
			"@koishi-ce/console": ["./packages/node/console/src"],
			"@koishi-ce/core": ["./packages/node/core/src"],
			"@koishi-ce/i18n-utils": ["./packages/node/i18n-utils/src"],
			"@koishi-ce/loader": ["./packages/node/loader/src"],
			"@koishi-ce/utils": ["./packages/node/utils/src"],
			"@koishi-ce/client": ["./packages/web/client/src"],
			"@koishi-ce/client/lib": ["./packages/web/client/src"],
			"@koishi-ce/components": ["./packages/web/components/src"],
			"@koishi-ce/market": ["./packages/web/market/src"],
			"@koishi-ce/plugin-bind": ["./plugins/common/bind/src"],
			"@koishi-ce/plugin-broadcast": ["./plugins/common/broadcast/src"],
			"@koishi-ce/plugin-callme": ["./plugins/common/callme/src"],
			"@koishi-ce/plugin-echo": ["./plugins/common/echo/src"],
			"@koishi-ce/plugin-help": ["./plugins/common/help/src"],
			"@koishi-ce/plugin-inspect": ["./plugins/common/inspect/src"],
			"@koishi-ce/plugin-hmr": ["./plugins/infra/hmr/src"],
			"@koishi-ce/plugin-mock": ["./plugins/infra/mock/src"],
			"@koishi-ce/plugin-actions": ["./plugins/webui/actions/src"],
			"@koishi-ce/plugin-admin": ["./plugins/webui/admin/src"],
			"@koishi-ce/plugin-analytics": ["./plugins/webui/analytics/src"],
			"@koishi-ce/plugin-auth": ["./plugins/webui/auth/src"],
			"@koishi-ce/plugin-commands": ["./plugins/webui/commands/src"],
			"@koishi-ce/plugin-config": ["./plugins/webui/config/src"],
			"@koishi-ce/plugin-console": ["./plugins/webui/console/src"],
			"@koishi-ce/plugin-explorer": ["./plugins/webui/explorer/src"],
			"@koishi-ce/plugin-insight": ["./plugins/webui/insight/src"],
			"@koishi-ce/plugin-locales": ["./plugins/webui/locales/src"],
			"@koishi-ce/plugin-logger": ["./plugins/webui/logger/src"],
			"@koishi-ce/plugin-marketn": ["./plugins/webui/market/src"],
			"@koishi-ce/plugin-marketn/shared": ["./plugins/webui/market/src/shared"],
			"@koishi-ce/plugin-config/client": ["./plugins/webui/config/client"],
			"@koishi-ce/plugin-notifier": ["./plugins/webui/notifier/src"],
			"@koishi-ce/plugin-oobe": ["./plugins/webui/oobe/src"],
			"@koishi-ce/plugin-sandbox": ["./plugins/webui/sandbox/src"],
			"@koishi-ce/plugin-status": ["./plugins/webui/status/src"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "@satorijs/element",
		"strict": true,
		"strictBindCallApply": true,
		"alwaysStrict": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true
	}
}
