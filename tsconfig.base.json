// 类型检查基座：只被 extends，从不直接作为 tsc 入口。真实门禁是根 tsconfig.json
// （node 侧）与 tsconfig.web.json（client 侧）两条大一统检查。files/include 跨
// extends 是整体替换而非合并，子配置声明的 include 会覆盖本 files——故下方
// files 仅是无 include 的配置直连本文件时的兜底，不是（也决定不了）检查范围。
// 不开启的选项与理由见文件尾注。
{
	"$schema": "https://json.schemastore.org/tsconfig",
	"files": [
		"packages/node/core/src/i18n/yml.d.ts"
	],
	"compilerOptions": {
		"target": "ES2025",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"moduleDetection": "force",
		"lib": [
			"ES2025"
		],
		"types": [
			"node",
			"bun"
		],
		"paths": {
			// nodenext 的 paths 目标必须是具体文件（不做目录 index 探测），否则回退
			// node_modules 解析到 lib 产物 d.ts，与 src 源码形成双模块视图，增广合并即冲突
			"@koishi-ce/koishi": [
				"./packages/node/cli/src/index.ts"
			],
			"@koishi-ce/console": [
				"./packages/node/console/src/index.ts"
			],
			"@koishi-ce/core": [
				"./packages/node/core/src/index.ts"
			],
			"@koishi-ce/i18n-utils": [
				"./packages/node/i18n-utils/src/index.ts"
			],
			"@koishi-ce/loader": [
				"./packages/node/loader/src/index.ts"
			],
			"@koishi-ce/registry": [
				"./packages/node/registry/src/index.ts"
			],
			"@koishi-ce/utils": [
				"./packages/node/utils/src/index.ts"
			],
			"@koishi-ce/assets": [
				"./packages/node/assets/src/index.ts"
			],
			"@koishi-ce/client": [
				"./packages/web/client/src/index.ts"
			],
			"@koishi-ce/client/lib": [
				"./packages/web/client/src/index.ts"
			],
			"@koishi-ce/components": [
				"./packages/web/components/client/index.ts"
			],
			"@koishi-ce/plugin-assets-local": [
				"./plugins/common/assets-local/src/index.ts"
			],
			"@koishi-ce/plugin-bind": [
				"./plugins/common/bind/src/index.ts"
			],
			"@koishi-ce/plugin-broadcast": [
				"./plugins/common/broadcast/src/index.ts"
			],
			"@koishi-ce/plugin-callme": [
				"./plugins/common/callme/src/index.ts"
			],
			"@koishi-ce/plugin-cron": [
				"./plugins/common/cron/src/index.ts"
			],
			"@koishi-ce/plugin-echo": [
				"./plugins/common/echo/src/index.ts"
			],
			"@koishi-ce/plugin-help": [
				"./plugins/common/help/src/index.ts"
			],
			"@koishi-ce/plugin-inspect": [
				"./plugins/common/inspect/src/index.ts"
			],
			"@koishi-ce/plugin-rate-limit": [
				"./plugins/common/rate-limit/src/index.ts"
			],
			"@koishi-ce/plugin-hmr": [
				"./plugins/infra/hmr/src/index.ts"
			],
			"@koishi-ce/plugin-mock": [
				"./plugins/infra/mock/src/index.ts"
			],
			"@koishi-ce/plugin-database-memory": [
				"./plugins/infra/memory/src/index.ts"
			],
			"@koishi-ce/plugin-database-sqlite": [
				"./plugins/infra/sqlite/src/index.ts"
			],
			"@koishi-ce/plugin-server-temp": [
				"./plugins/infra/server-temp/src/index.ts"
			],
			"@koishi-ce/plugin-actions": [
				"./plugins/webui/actions/src/index.ts"
			],
			"@koishi-ce/plugin-admin": [
				"./plugins/webui/admin/src/index.ts"
			],
			"@koishi-ce/plugin-analytics": [
				"./plugins/webui/analytics/src/index.ts"
			],
			"@koishi-ce/plugin-auth": [
				"./plugins/webui/auth/src/index.ts"
			],
			"@koishi-ce/plugin-commands": [
				"./plugins/webui/commands/src/index.ts"
			],
			"@koishi-ce/plugin-config": [
				"./plugins/webui/config/src/index.ts"
			],
			"@koishi-ce/plugin-console": [
				"./plugins/webui/console/src/index.ts"
			],
			"@koishi-ce/plugin-dataview": [
				"./plugins/webui/dataview/src/index.ts"
			],
			"@koishi-ce/plugin-explorer": [
				"./plugins/webui/explorer/src/index.ts"
			],
			"@koishi-ce/plugin-insight": [
				"./plugins/webui/insight/src/index.ts"
			],
			"@koishi-ce/plugin-locales": [
				"./plugins/webui/locales/src/index.ts"
			],
			"@koishi-ce/plugin-logger": [
				"./plugins/webui/logger/src/index.ts"
			],
			"@koishi-ce/plugin-market": [
				"./plugins/webui/market/src/index.ts"
			],
			"@koishi-ce/plugin-market/shared": [
				"./plugins/webui/market/src/shared/index.ts"
			],
			"@koishi-ce/plugin-config/client": [
				"./plugins/webui/config/client/index.ts"
			],
			"@koishi-ce/plugin-notifier": [
				"./plugins/webui/notifier/src/index.ts"
			],
			"@koishi-ce/plugin-oobe": [
				"./plugins/webui/oobe/src/index.ts"
			],
			"@koishi-ce/plugin-sandbox": [
				"./plugins/webui/sandbox/src/index.ts"
			],
			"@koishi-ce/plugin-status": [
				"./plugins/webui/status/src/index.ts"
			],
			"@koishi-ce/plugin-theme-vanilla": [
				"./plugins/webui/theme-vanilla/src/index.ts"
			]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "@satorijs/element",
		"strict": true,
		// 以下两项已被 strict 涵盖，显式写出仅为自文档，无语义差异
		"strictBindCallApply": true,
		"alwaysStrict": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		// 刻意保持 true（2026-09-18 实测 false）：node 侧爆 8 条、client 侧爆 63 条
		// 第三方 d.ts 错误（@satorijs/core、@types/bun、@vueuse/core 等），本仓代码
		// 零条——关它等于让门禁被上游依赖的类型质量绑架；自家产物 d.ts 的校验
		// 由 tsdown 构建链承担。
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		// 对不存在的副作用导入（如 import "./x.css"）报 TS2882；TS7 在 project
		// 模式真实生效（探针实证），全仓零误报，纯增量防线
		"noUncheckedSideEffectImports": true,
		// 报错展示 DX 项：不截断长类型错误，不影响任何检查结果
		"noErrorTruncation": true
	}
}
// 经实证不开启的选项（2026-09-18，勿凭清单式印象再提）：
// - isolatedDeclarations：TS7 原生编译器在 project/noEmit 模式下不执行该检查
//   （同文件走 CLI 文件模式才报 TS9013），本仓 noEmit 大一统架构下是安慰剂
//   配置；且与 checkJs 互斥（后者隐含 allowJs，同开报 TS5053）。
// - checkJs：隐含 allowJs 而类型程序无 .js 源（vendored 预编译包不在 include
//   内），开则空转。
// - skipLibCheck: false：理由见 skipLibCheck 行注。