{
	"name": "@koishi-ce/plugin-console",
	"description": "Web User Interface for Koishi",
	"version": "1.4.1",
	"type": "module",
	"main": "lib/node/index.mjs",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"node": {
				"import": "./lib/node/index.mjs",
				"default": "./lib/node/index.mjs"
			},
			"browser": "./lib/browser/index.mjs"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"dist",
		"src"
	],
	"contributors": [
		"Shigma <shigma10826@gmail.com>",
		"Oppenheymu <oppenheymu@gmail.com>"
	],
	"license": "AGPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Koishi-CE/koishi.git",
		"directory": "plugins/webui/console"
	},
	"bugs": {
		"url": "https://github.com/Koishi-CE/koishi/issues"
	},
	"homepage": "https://koishi.chat/plugins/console/",
	"keywords": [
		"bot",
		"chatbot",
		"koishi",
		"plugin",
		"frontend",
		"webui",
		"console",
		"service"
	],
	"koishi": {
		"description": {
			"en": "Web UI interface",
			"zh": "网页控制台"
		},
		"service": {
			"implements": [
				"console"
			]
		}
	},
	"peerDependencies": {
		"@koishi-ce/client": "^1.0.0",
		"@koishi-ce/console-app": "^1.0.0",
		"@koishi-ce/console-builder": "^1.0.0",
		"@koishi-ce/koishi": "^1.0.0"
	},
	"peerDependenciesMeta": {
		"@koishi-ce/client": {
			"optional": true
		},
		"@koishi-ce/console-app": {
			"optional": true
		},
		"@koishi-ce/console-builder": {
			"optional": true
		}
	},
	"devDependencies": {
		"@koishi-ce/client": "workspace:*",
		"@koishi-ce/console-app": "workspace:*",
		"@koishi-ce/console-builder": "workspace:*",
		"@koishi-ce/loader": "workspace:*",
		"@koishi-ce/plugin-server": "workspace:*",
		"@koishijs/plugin-server-proxy": "^1.2.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@koishi-ce/console": "workspace:*",
		"open": "^11.0.1"
	}
}