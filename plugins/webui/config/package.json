{
	"name": "@koishi-ce/plugin-config",
	"description": "Manage your bots and plugins with console",
	"version": "1.0.8",
	"type": "module",
	"main": "lib/index.mjs",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"import": "./lib/index.mjs",
			"default": "./lib/index.mjs"
		},
		"./shared": {
			"import": "./lib/shared/index.mjs",
			"default": "./lib/shared/index.mjs"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"dist",
		"src"
	],
	"contributors": [
		"Shigma <shigma10826@gmail.com>",
		"Oppenheymu <oppenheymu@gmail.com>"
	],
	"license": "AGPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Koishi-CE/koishi.git",
		"directory": "plugins/webui/config"
	},
	"bugs": {
		"url": "https://github.com/Koishi-CE/koishi/issues"
	},
	"homepage": "https://koishi.chat/plugins/console/config.html",
	"keywords": [
		"bot",
		"chatbot",
		"koishi",
		"plugin",
		"config",
		"manager",
		"server"
	],
	"koishi": {
		"public": [
			"dist"
		],
		"description": {
			"en": "Configure your plugins with console",
			"zh": "使用控制台查看、配置你的插件"
		},
		"service": {
			"required": [
				"console"
			]
		}
	},
	"peerDependencies": {
		"@koishi-ce/loader": "^1.0.0",
		"@koishi-ce/plugin-console": "^1.0.0",
		"@koishi-ce/koishi": "^1.0.0"
	},
	"devDependencies": {
		"@koishi-ce/client": "workspace:*",
		"@koishi-ce/plugin-hmr": "workspace:*",
		"element-plus": "^2.14.5",
		"vue": "^3.5.12",
		"vue-router": "^5.2.0"
	},
	"dependencies": {
		"@koishi-ce/console": "workspace:*",
		"@koishi-ce/loader": "workspace:*",
		"@koishi-ce/registry": "workspace:*"
	}
}
