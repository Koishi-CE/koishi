{
    "name": "@koishi-ce/plugin-welcome",
    "description": "Welcome page for Koishi console",
    "version": "1.0.1",
    "type": "module",
    "main": "lib/index.mjs",
    "typings": "lib/index.d.ts",
    "files": [
        "lib",
        "dist",
        "src"
    ],
    "contributors": [
        "Il Harper <hi@ilharper.com>",
        "Shigma <shigma10826@gmail.com>",
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
