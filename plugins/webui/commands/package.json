{
    "name": "@koishi-ce/plugin-commands",
    "description": "Override Command Config for Koishi",
    "version": "1.0.0",
    "type": "module",
    "main": "lib/index.mjs",
    "typings": "lib/index.d.ts",
    "files": [
        "lib",
        "dist",
        "src",
        "locales"
    ],
    "contributors": [
        "Shigma <shigma10826@gmail.com>",
        "Oppenheymu <oppenheymu@gmail.com>"
    ],
    "license": "AGPL-3.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Koishi-CE/koishi.git",
        "directory": "plugins/webui/commands"
    },
    "bugs": {
        "url": "https://github.com/Koishi-CE/koishi/issues"
    },
    "homepage": "https://koishi.chat/plugins/console/commands.html",
    "keywords": [
        "bot",
        "chatbot",
        "koishi",
        "plugin",
        "command"
    ],
    "koishi": {
        "public": [
            "dist"
        ],
        "description": {
            "en": "Override command config",
            "zh": "修改指令配置 (如指令别名、权限等级、层级关系等)"
        },
        "service": {
            "optional": [
                "console"
            ]
        }
    },
    "peerDependencies": {
        "@koishi-ce/plugin-console": "^1.0.0",
        "@koishi-ce/koishi": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "@koishi-ce/plugin-console": {
            "optional": true
        }
    },
    "devDependencies": {
        "@koishi-ce/client": "workspace:*",
        "@koishi-ce/plugin-config": "workspace:*",
        "@koishi-ce/plugin-console": "workspace:*",
        "@koishi-ce/plugin-help": "workspace:*",
        "@koishi-ce/plugin-locales": "workspace:*",
        "@koishi-ce/plugin-mock": "workspace:*",
        "@koishi-ce/koishi": "workspace:*"
    },
    "dependencies": {
        "@koishi-ce/console": "workspace:*"
    },
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "default": "./lib/index.mjs"
        }
    }
}