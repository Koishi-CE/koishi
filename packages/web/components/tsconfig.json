{
	"extends": "../../../tsconfig.client",
	"include": ["src"],
	"exclude": ["./src/form/schemastery-runtime.ts"],
	"compilerOptions": {
		// paths 勿删：bun test 只认本文件直接声明的 paths（不跟随 extends），测试经
		// form/index.ts 拉入 "schemastery-vue/client" 导入——该子路径在 schemastery-vue
		// 包内不存在，无映射即 MODULE_NOT_FOUND；compiler-sfc 解析 .vue 内类型时也只认
		// tsconfig paths（自发起文件向上找最近 tsconfig，命中的即本文件）。机理详见
		// src/form/schemastery-client.ts 头注释。paths 无 baseUrl 时相对本文件解析，
		// 与已删除的 baseUrl: "." 等价（过时用法）。
		"paths": {
			"schemastery-vue/client": [
				"./src/form/schemastery-client.ts"
			],
			// client 包无 lib 产物，node_modules 解析必死，须显式指源码
			// （与 tsconfig.client.json / tsconfig.web.json 同款映射；
			// 本文件声明了 paths 即整体替换 extends 链，基座映射不继承）
			"@koishi-ce/client": ["../client/src/index.ts"]
		},
		// 本文件是 IDE 的归属锚（门禁走 tsconfig.web.json，*.test.ts 被 exclude，
		// 不经本程序）。src 下 *.test.ts 归属到这后要解析 bun:test，而基座 types:[]
		// 是浏览器纯净——补 "bun" 仅为 IDE 观感（声明链携带的 bun 全局只在 IDE
		// 生效），门禁的浏览器纯净由 client 程序的 types:[] 保持。
		"types": ["bun"]
	}
}
