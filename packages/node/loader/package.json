{
	"name": "@koishi-ce/loader",
	"description": "Config Loader for Koishi",
	"version": "1.0.3",
	"type": "module",
	"main": "lib/index.mjs",
	"module": "lib/index.mjs",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./lib/index.d.ts",
			"node": {
				"import": "./lib/index.mjs",
				"default": "./lib/index.mjs"
			},
			"browser": "./lib/shared.mjs"
		},
		"./shared": {
			"source": "./src/shared.ts",
			"types": "./lib/shared.d.ts",
			"import": "./lib/shared.mjs",
			"default": "./lib/shared.mjs"
		},
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src"
	],
	"contributors": [
		"Shigma <shigma10826@gmail.com>",
		"Oppenheymu <oppenheymu@gmail.com>"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Koishi-CE/koishi.git",
		"directory": "packages/node/loader"
	},
	"bugs": {
		"url": "https://github.com/Koishi-CE/koishi/issues"
	},
	"homepage": "https://koishi.chat/api/utils.html",
	"keywords": [
		"bot",
		"chatbot",
		"koishi",
		"loader",
		"config"
	],
	"peerDependencies": {
		"@koishijs/core": "4.18.11"
	},
	"devDependencies": {
		"@koishi-ce/core": "workspace:*",
		"@koishi-ce/plugin-mock": "workspace:*",
		"@koishi-ce/koishi": "workspace:*"
	}
}
