{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 60,
		"attributePosition": "multiline"
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/lib",
			"!**/dist",
			"!**/*.tsbuildinfo"
		]
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noAssignInExpressions": "off",
				"useIterableCallbackReturn": "off",
				"noUnsafeDeclarationMerging": "off",
				"noRedeclare": "off",
				"noThenProperty": "off",
				"noShadowRestrictedNames": "off"
			},
			"correctness": {
				"noUnresolvedImports": "off"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
			"style": {
				"useNamingConvention": "off"
			},
			"nursery": {
				"noFloatingPromises": "off"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"plugins": [
		{
			"path": "./tooling/checks/no-double-cast.grit",
			"includes": [
				"**",
				"!**/*.{test,spec}.*",
				"!**/__tests__/**",
				"!**/__mocks__/**",
				"!**/vendor/**",
				"!packages/shim/**",
				"!plugins/infra/{http,proxy,server}/**",
				"!apps/*/src/template/**"
			]
		}
	],
	"overrides": [
		{
			"includes": ["**/tests/**", "**/*.{spec,test}.*"],
			"linter": {
				"rules": {
					"suspicious": {
						"noTemplateCurlyInString": "off"
					},
					"style": {
						"useNamingConvention": "off",
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.vue"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"noUnusedFunctionParameters": "off"
					},
					"style": {
						"useVueMultiWordComponentNames": "off",
						"useImportType": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/*/src/template/**"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": ["**/assets/icons/**"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": ["**/package.json"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": [
				"packages/web/components/src/shims.d.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"useExportType": "off"
					}
				}
			}
		}
	]
}
