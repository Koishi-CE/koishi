{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/lib",
			"!**/dist",
			"!**/*.tsbuildinfo"
		]
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noAssignInExpressions": "off",
				"useIterableCallbackReturn": "off",
				"noUnsafeDeclarationMerging": "off",
				"noRedeclare": "off",
				"noThenProperty": "off",
				"noShadowRestrictedNames": "off"
			},
			"correctness": {
				"noUnresolvedImports": "off"
			},
			"complexity": {
				"useLiteralKeys": "off"
			},
			"style": {
				"useNamingConvention": "off"
			},
			"nursery": {
				"noFloatingPromises": "error"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/tests/**", "**/*.{spec,test}.*"],
			"linter": {
				"rules": {
					"suspicious": {
						"noTemplateCurlyInString": "off"
					},
					"style": {
						"useNamingConvention": "off",
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.vue"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"noUnusedFunctionParameters": "off"
					},
					"style": {
						"useVueMultiWordComponentNames": "off",
						"useImportType": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/*/src/template/**"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			}
		}
	]
}
