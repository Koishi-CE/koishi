# build outputs (monorepo)
**/lib/
**/dist/

# local / temp
external/

# koishi 适配器 submodule（独立仓库，自带工具链；主仓库 biome/tsc 均跳过）
apps/koishi-plugin-adapter/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# typescript build info
**/*.tsbuildinfo

# tool caches
.eslintcache
.turbo/
# fallow 的本地缓存目录：它自带的 .fallow/.gitignore（内容 `*`）对 turbo 无效，
# 该文件仍会被算进根任务 inputs，使本地缓存键与 CI 永久错开——整目录显式忽略
.fallow/

# test coverage
coverage/

# OS / IDE
.DS_Store
.idea/
.VSCodeCounter
.vscode/*.local.json
.vscode/*.code-workspace
.zcode/

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

# 归档区
archive/

# token
.npmrc

# 一些缓存
.pnpm-store
.repo/
tmp.txt

# 配置
/koishi.yml
data/
